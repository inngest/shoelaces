{{define "generated/static/firstboot.service" -}}
[Unit]
Description=Run Shoelaces firstboot tasks and then exit
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/firstboot
ExecStart=/usr/local/bin/firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
{{end}}
