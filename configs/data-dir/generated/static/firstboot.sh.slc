{{define "generated/static/firstboot.sh" -}}
#!/bin/sh
set -eu

exec >> /var/log/firstboot.log 2>&1

FIRSTBOOT_DONE=/var/lib/firstboot.done
FIRSTBOOT_FAILED=/var/lib/firstboot.failed
FIRSTBOOT_STATE_DIR=/var/lib/firstboot
FIRSTBOOT_STATUS="$FIRSTBOOT_STATE_DIR/status.json"
FIRSTBOOT_PHASE=init

mkdir -p "$FIRSTBOOT_STATE_DIR"

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_firstboot_status() {
  status="$1"
  rc="$2"
  timestamp="$(date -Is)"
  {
    printf '{\n'
    printf '  "status": "%s",\n' "$(json_escape "$status")"
    printf '  "phase": "%s",\n' "$(json_escape "$FIRSTBOOT_PHASE")"
    printf '  "exit_code": %s,\n' "$rc"
    printf '  "timestamp": "%s"\n' "$(json_escape "$timestamp")"
    printf '}\n'
  } > "$FIRSTBOOT_STATUS"
}

firstboot_phase() {
  FIRSTBOOT_PHASE="$1"
  printf '\n=== firstboot phase: %s @ %s ===\n' "$FIRSTBOOT_PHASE" "$(date -Is)"
  write_firstboot_status running 0
}

mark_firstboot_failed() {
  rc="$?"
  if [ "$rc" -ne 0 ]; then
    write_firstboot_status failed "$rc"
    {
      printf 'firstboot failed at %s\n' "$(date -Is)"
      printf 'phase=%s\n' "$FIRSTBOOT_PHASE"
      printf 'exit_code=%s\n' "$rc"
    } > "$FIRSTBOOT_FAILED"
  fi
  exit "$rc"
}

trap mark_firstboot_failed EXIT

firstboot_phase start

if [ -f "$FIRSTBOOT_DONE" ]; then
  write_firstboot_status already_complete 0
  exit 0
fi
rm -f "$FIRSTBOOT_FAILED"

firstboot_phase load-defaults

[ -f /etc/default/firstboot ] && . /etc/default/firstboot

: "${FIRSTBOOT_LUKS_TPM_PASSPHRASE_FILE:=/var/lib/firstboot/luks-tpm.passphrase}"
: "${FIRSTBOOT_LUKS_TPM_PCRS:=7}"

firstboot_phase reenroll-luks-tpm

# The installer enrolls a temporary no-PCR TPM token because PXE installer PCRs
# differ from installed-disk boot PCRs. Re-enroll here from the real disk boot
# context so the steady-state token is bound to normal boot PCRs.
if [ -f "$FIRSTBOOT_LUKS_TPM_PASSPHRASE_FILE" ]; then
  root_source="$(findmnt -no SOURCE /)"
  case "$root_source" in
    /dev/mapper/*)
      crypt_name="${root_source#/dev/mapper/}"
      backing_device="$(cryptsetup status "$crypt_name" | sed -n 's/^[[:space:]]*device:[[:space:]]*//p')"
      if [ -z "$backing_device" ]; then
        echo "cannot resolve LUKS backing device for $crypt_name" >&2
        exit 1
      fi

      systemd-cryptenroll --tpm2-device=list
      systemd-cryptenroll "$backing_device" --wipe-slot=tpm2
      systemd-cryptenroll "$backing_device" \
        --unlock-key-file="$FIRSTBOOT_LUKS_TPM_PASSPHRASE_FILE" \
        --tpm2-device=auto \
        --tpm2-pcrs="$FIRSTBOOT_LUKS_TPM_PCRS"

      luks_dump_file="$FIRSTBOOT_STATE_DIR/luks-tpm-reenroll.luksdump"
      cryptsetup luksDump "$backing_device" > "$luks_dump_file"
      cat "$luks_dump_file"
      grep -q 'systemd-tpm2' "$luks_dump_file"
      grep -E "tpm2-hash-pcrs:[[:space:]]*$FIRSTBOOT_LUKS_TPM_PCRS" "$luks_dump_file"
      grep -E 'tpm2-pcr-bank:[[:space:]]*sha256' "$luks_dump_file"
      rm -f "$FIRSTBOOT_LUKS_TPM_PASSPHRASE_FILE"
      ;;
    *)
      echo "root_source=$root_source is not a LUKS mapper; skipping TPM re-enrollment"
      ;;
  esac
else
  echo "No firstboot LUKS TPM passphrase file found; skipping TPM re-enrollment"
fi

firstboot_phase complete
rm -f "$FIRSTBOOT_FAILED"
write_firstboot_status succeeded 0
touch "$FIRSTBOOT_DONE"
{{end}}
