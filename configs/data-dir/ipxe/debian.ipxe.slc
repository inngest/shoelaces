{{define "debian.ipxe" -}}
#!ipxe

echo Debian {{.release}} netboot (this will erase disks)

set mirror http://ftp.debian.org/debian/dists/{{.release}}/main/installer-amd64/current/images/netboot/debian-installer/amd64

# Choose interface: use `.iface` from mappings if set; else auto
set iface {{ if .iface }}{{ .iface }}{{ else }}auto{{ end }}

chain http://{{.baseURL}}/configs/linux.cfg?hostname={{.hostname}}

imgfree

# Stronger, safer defaults:
#  - netcfg/choose_interface=auto + ip=dhcp ensures an interface comes up
#  - hostname/domain make the installer happy when fully automated
#  - firmware=1 asks the installer to load needed firmware
#  - preseed/url points at our served preseed
kernel ${mirror}/linux \
  auto=true priority=critical \
  netcfg/choose_interface=auto \
  ip=dhcp \
  hostname={{ .hostname }} \
  domain=local \
  firmware=1 \
  preseed/url=http://{{.baseURL}}/configs/preseed/debian?encrypt_home={{.encrypt_home}}\
&ssh_authorized_key={{ .ssh_authorized_key }}\
&ansible_repo_url={{ .ansible_repo_url }}\
&ansible_branch={{ .ansible_branch }}\
&ansible_playbook={{ .ansible_playbook }} \
  {{if .linuxargs}}{{.linuxargs}}{{end}}

initrd ${mirror}/initrd.gz
boot
{{end}}
