{{define "centos.ipxe" -}}
#!ipxe
set hostname {{.hostname}}
set release {{.release}}
set base {{.repo_centos_mirror}}/${release}/os/x86_64

echo This automatically overwrites data!
echo CentOS ${release}
echo Installing ${hostname}

kernel ${base}/images/pxeboot/vmlinuz initrd=initrd.img repo=${base} ks=http://{{.baseURL}}/configs/{{.centos_installer_config_template}}?hostname=${hostname}&release=${release}{{.installer_config_query_suffix}} {{.linuxargs}}
initrd ${base}/images/pxeboot/initrd.img
boot
{{end}}
