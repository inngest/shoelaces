{{define "preseed/debian" -}}
{{template "preseed/common"}}

# ---- Repos / firmware sections (Debian 12+)
d-i hw-detect/load_firmware boolean true
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true

# ---- Select installation disk
d-i partman-auto/disk string /dev/nvme0n1

# ---- HARD RESET OF BOTH NVMes (kills old GPT/md/LVM) ----
# Runs inside d-i's busybox shell (/bin/ash) – that's intentional.
d-i partman/early_command string \
  /bin/ash -c 'set -eux; \
    mdadm --stop --scan || true; \
    vgchange -an || true; \
    vgs --noheadings -o vg_name 2>/dev/null | awk "NF{print \$1}" | while read -r vg; do vgremove -ff "$vg" || true; done; \
    pvs --noheadings -o pv_name 2>/dev/null | awk "NF{print \$1}" | while read -r pv; do pvremove -ff "$pv" || true; done; \
    for d in /dev/nvme0n1 /dev/nvme1n1; do \
      [ -b "$d" ] || continue; \
      sfdisk --delete "$d" 2>/dev/null || true; \
      dd if=/dev/zero of="$d" bs=1M count=10 conv=fsync || true; \
    done'

d-i anna/choose_modules string lvm2-udeb partman-lvm partman-ext4

# Use LVM
d-i partman-auto/method string lvm
d-i partman-auto-lvm/guided_size string max

# Make sure any leftovers can be replaced without prompts
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true

# Expert recipe: ESP + LVM PV, with root+swap LVs
# LVM recipe: ESP + PV on nvme0n1 + LVs (root, swap)
d-i partman-auto/expert_recipe string \
  uefi-lvm ::                                                            \
    512 512 512 fat32                                                    \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        mountpoint{ /boot/efi }                                          \
    .                                                                    \
    1000 10000 -1 lvm                                                    \
        $primary{ } $iflabel{ gpt }                                      \
        method{ lvm }                                                    \
        device{ /dev/nvme0n1 }                                           \
        vg_name{ {{ if .vg_name }}{{ .vg_name }}{{ else }}vg0{{ end }} } \
    .                                                                    \
    8192 8192 8192 linux-swap                                            \
        $lvmok{ }                                                        \
        in_vg{ {{ if .vg_name }}{{ .vg_name }}{{ else }}vg0{{ end }} }   \
        lv_name{ swap }                                                  \
        method{ swap } format{ }                                         \
    .                                                                    \
    20000 100000000 -1 ext4                                              \
        $lvmok{ }                                                        \
        in_vg{ {{ if .vg_name }}{{ .vg_name }}{{ else }}vg0{{ end }} }   \
        lv_name{ root }                                                  \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ ext4 }                             \
        mountpoint{ / }                                                  \
    .

d-i partman-auto/choose_recipe select uefi-lvm

# Commit without asking
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman/choose_partition select finish

# ---- GRUB (UEFI)
d-i grub-installer/target string amd64-efi

# ---- Locale/time/pkgs
d-i user-setup/encrypt-home boolean {{ .encrypt_home }}
d-i base-installer/install-recommends boolean true
d-i clock-setup/utc boolean true
d-i time/zone string America/Los_Angeles
d-i clock-setup/ntp boolean true
d-i debian-installer/quiet boolean false
d-i debian-installer/splash boolean false
d-i pkgsel/update-policy select unattended-upgrades
d-i pkgsel/include string openssh-server curl ca-certificates git ansible-core

# ---- First-boot bootstrap
d-i preseed/late_command string \
  set -eux; \
  wget -O /target/usr/local/bin/firstboot.sh http://{{ .baseURL }}/static/firstboot.sh; \
  chmod 0755 /target/usr/local/bin/firstboot.sh; \
  mkdir -p /target/etc/systemd/system; \
  cat >/target/etc/systemd/system/firstboot.service <<'EOF_SYSUNIT'\n[Unit]\nDescription=Run first-boot bootstrap and then exit\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/usr/local/bin/firstboot.sh\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\nEOF_SYSUNIT\n; \
  chroot /target /bin/ln -sf /etc/systemd/system/firstboot.service /etc/systemd/system/multi-user.target.wants/firstboot.service; \
  install -d -m 0700 /target/root/.ssh; \
  wget -O /target/root/.ssh/authorized_keys http://{{ .baseURL }}/static/authorized_keys; \
  chmod 0600 /target/root/.ssh/authorized_keys; \
  chown -R 0:0 /target/root/.ssh; \
  printf "\nUseDNS no\n" >> /target/etc/ssh/sshd_config

d-i grub-installer/timeout string 5
d-i popularity-contest/participate boolean false
d-i finish-install/reboot_in_progress note
{{end}}
