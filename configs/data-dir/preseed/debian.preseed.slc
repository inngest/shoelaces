{{define "preseed/debian" -}}
{{template "preseed/common" .}}

# ---- Repos / firmware sections (Debian 12+)
d-i hw-detect/load_firmware boolean {{.repo_firmware}}
d-i apt-setup/non-free-firmware boolean {{.repo_firmware}}
d-i apt-setup/non-free boolean {{.repo_non_free}}
d-i apt-setup/contrib boolean {{.repo_contrib}}

{{template "preseed/debian/storage" .}}
{{template "preseed/debian/packages" .}}
{{.installerExtra}}
{{template "preseed/debian/finish" .}}
{{end}}

{{define "preseed/debian/storage" -}}
# ---- Select installation disk
{{if eq .storage_mode "raid" -}}
d-i partman-auto/disk string {{.storage_raid_devices}}
{{else -}}
d-i partman-auto/disk string {{.storage_disk}}
{{end}}

{{if eq .storage_mode "regular" -}}
{{if ne .storage_encryption_enabled "true" -}}
{{template "preseed/debian/storage/wipe" .}}
{{end -}}
{{else -}}
{{template "preseed/debian/storage/wipe" .}}
{{end -}}
{{template "preseed/debian/storage/encryption" .}}
{{if eq .storage_mode "lvm" -}}
{{if eq .storage_encryption_enabled "true" -}}
{{template "preseed/debian/storage/lvm/encrypted" .}}
{{else -}}
{{template "preseed/debian/storage/lvm" .}}
{{end -}}
{{else if eq .storage_mode "raid" -}}
{{if eq .storage_encryption_enabled "true" -}}
{{template "preseed/debian/storage/raid/encrypted" .}}
{{else -}}
{{template "preseed/debian/storage/raid" .}}
{{end -}}
{{else -}}
{{if eq .storage_encryption_enabled "true" -}}
{{template "preseed/debian/storage/regular/encrypted" .}}
{{else -}}
{{template "preseed/debian/storage/regular" .}}
{{end -}}
{{end -}}
{{template "preseed/debian/storage/commit" .}}
{{template "preseed/debian/storage/grub" .}}
{{end}}

{{define "preseed/debian/storage/encryption" -}}
{{if eq .storage_encryption_enabled "true" -}}
# ---- LUKS encryption answers ----
d-i partman-crypto/passphrase password {{.storage_encryption_passphrase}}
d-i partman-crypto/passphrase-again password {{.storage_encryption_passphrase}}
d-i partman-crypto/weak_passphrase boolean true
d-i partman-crypto/confirm boolean true
d-i partman-crypto/confirm_nooverwrite boolean true
d-i partman-crypto/erase_disks boolean false
{{end -}}
{{end}}

{{define "preseed/debian/storage/wipe" -}}
{{if eq .storage_wipe "true" -}}
# ---- HARD RESET OF SELECTED WIPE DISKS (kills old GPT/md/LVM) ----
# Runs inside d-i's busybox shell (/bin/ash) – that's intentional.
# storage_wipe_disks may contain explicit /dev glob patterns; unmatched globs
# are skipped by the block-device check below. Matched partitions are skipped:
# storage_wipe_disks selectors are disk selectors, not partition selectors.
d-i partman/early_command string \
  /bin/ash -c 'set -eux; \
    mdadm --stop --scan || true; \
    vgchange -an || true; \
    vgs --noheadings -o vg_name 2>/dev/null | awk "NF{print \$1}" | while read -r vg; do vgremove -ff "$vg" || true; done; \
    pvs --noheadings -o pv_name 2>/dev/null | awk "NF{print \$1}" | while read -r pv; do pvremove -ff "$pv" || true; done; \
    for d in {{.storage_wipe_disks}}; do \
      [ -b "$d" ] || continue; \
      d="$(readlink -f "$d" 2>/dev/null || echo "$d")"; \
      b="${d##*/}"; \
      [ ! -e "/sys/class/block/$b/partition" ] || continue; \
      sfdisk --delete "$d" 2>/dev/null || true; \
      dd if=/dev/zero of="$d" bs=1M count=10 conv=fsync || true; \
      sectors="$(blockdev --getsz "$d" 2>/dev/null || echo 0)"; \
      if [ "$sectors" -gt 20480 ]; then \
        seek="$((sectors - 20480))"; \
        dd if=/dev/zero of="$d" bs=512 seek="$seek" count=20480 conv=fsync || true; \
      fi; \
      blockdev --rereadpt "$d" 2>/dev/null || partprobe "$d" 2>/dev/null || true; \
    done'
{{end -}}
{{end}}

{{define "preseed/debian/storage/regular" -}}
d-i anna/choose_modules string {{.debian_regular_partman_modules}}

# Use selected storage method
d-i partman-auto/method string regular

# Make sure any md leftovers can be replaced without prompts
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true

# Expert recipe: ESP + /boot + swap + root on regular partitions
d-i partman-auto/expert_recipe string \
  uefi-regular ::                                                        \
    {{.debian_regular_esp_min_size_mib}} {{.debian_regular_esp_priority}} {{.debian_regular_esp_max_size_mib}} {{.debian_regular_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        mountpoint{ {{.debian_regular_esp_mountpoint}} }                 \
    .                                                                    \
    {{.debian_regular_boot_min_size_mib}} {{.debian_regular_boot_priority}} {{.debian_regular_boot_max_size_mib}} {{.debian_regular_boot_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ {{.debian_regular_boot_fstype}} }  \
        mountpoint{ {{.debian_regular_boot_mountpoint}} }                \
    .                                                                    \
{{if eq .debian_regular_swap_enabled "true" -}}
    {{.debian_regular_swap_min_size_mib}} {{.debian_regular_swap_priority}} {{.debian_regular_swap_max_size_mib}} linux-swap \
        method{ swap } format{ }                                         \
    .                                                                    \
{{end -}}
    {{.debian_regular_root_min_size_mib}} {{.debian_regular_root_priority}} {{.debian_regular_root_max_size_mib}} {{.debian_regular_root_fstype}} \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ {{.debian_regular_root_fstype}} }  \
        mountpoint{ {{.debian_regular_root_mountpoint}} }                \
    .

d-i partman-auto/choose_recipe select uefi-regular
{{end}}

{{define "preseed/debian/storage/regular/encrypted" -}}
d-i anna/choose_modules string crypto-dm-modules partman-auto-crypto partman-crypto {{.debian_regular_partman_modules}}

# Replace Debian's crypto autopartitioner helper. The stock helper always turns
# the opened LUKS mapper into an LVM PV; Shoelaces regular mode keeps the mapper
# as the formatted root filesystem. ESP and /boot stay unencrypted so UEFI
# firmware and GRUB can start before unlocking the root volume.
d-i partman/early_command string \
  /bin/ash -c 'set -eux; \
{{if eq .storage_wipe "true" -}}
    mdadm --stop --scan || true; \
    vgchange -an || true; \
    vgs --noheadings -o vg_name 2>/dev/null | awk "NF{print \$1}" | while read -r vg; do vgremove -ff "$vg" || true; done; \
    pvs --noheadings -o pv_name 2>/dev/null | awk "NF{print \$1}" | while read -r pv; do pvremove -ff "$pv" || true; done; \
    for d in {{.storage_wipe_disks}}; do \
      [ -b "$d" ] || continue; \
      d="$(readlink -f "$d" 2>/dev/null || echo "$d")"; \
      b="${d##*/}"; \
      [ ! -e "/sys/class/block/$b/partition" ] || continue; \
      sfdisk --delete "$d" 2>/dev/null || true; \
      dd if=/dev/zero of="$d" bs=1M count=16 conv=fsync || true; \
      sectors="$(blockdev --getsz "$d" 2>/dev/null || echo 0)"; \
      if [ "$sectors" -gt 32768 ]; then \
        seek="$((sectors - 32768))"; \
        dd if=/dev/zero of="$d" bs=512 seek="$seek" count=32768 conv=fsync || true; \
      fi; \
      blockdev --rereadpt "$d" 2>/dev/null || partprobe "$d" 2>/dev/null || true; \
    done; \
{{end -}}
    wget -O /bin/autopartition-crypto http://{{.baseURL}}/configs/static/plain-luks-autopartition-crypto.sh; \
    chmod 0755 /bin/autopartition-crypto'

d-i partman-auto/method string crypto

# Make sure any crypto/md leftovers can be replaced without prompts
d-i partman-crypto/device_remove_crypto boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true
{{if eq .debian_regular_swap_enabled "true" -}}
# Swap is created later as /swapfile on the encrypted root filesystem. The
# partitioner only sees partitions, so pre-answer its no-swap-partition prompt.
d-i partman-basicfilesystems/no_swap boolean false
{{end -}}

d-i partman-auto/expert_recipe string \
  uefi-regular-luks ::                                                   \
    {{.debian_regular_esp_min_size_mib}} {{.debian_regular_esp_priority}} {{.debian_regular_esp_max_size_mib}} {{.debian_regular_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        mountpoint{ {{.debian_regular_esp_mountpoint}} }                 \
    .                                                                    \
    {{.debian_regular_boot_min_size_mib}} {{.debian_regular_boot_priority}} {{.debian_regular_boot_max_size_mib}} {{.debian_regular_boot_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ {{.debian_regular_boot_fstype}} }  \
        mountpoint{ {{.debian_regular_boot_mountpoint}} }                \
    .                                                                    \
    {{.debian_regular_root_min_size_mib}} {{.debian_regular_root_priority}} {{.debian_regular_root_max_size_mib}} crypto \
        method{ crypto }                                                 \
        options/crypto_type{ luks }                                      \
        options/cipher{ {{.storage_encryption_cipher}} }                 \
        options/keysize{ {{.storage_encryption_key_size}} }              \
        options/hash{ {{.storage_encryption_hash}} }                     \
    .

d-i partman-auto/choose_recipe select uefi-regular-luks

d-i preseed/late_command string \
  set -eux; \
  root_source="$(awk '$2 == "/target" { print $1; exit }' /proc/mounts)"; \
  if echo "$root_source" | grep -q '^/dev/mapper/'; then \
    crypt_name="${root_source##*/}"; \
    backing_device="$(cryptsetup status "$crypt_name" | sed -n 's/^[[:space:]]*device:[[:space:]]*//p')"; \
    backing_uuid="$(cryptsetup luksUUID "$backing_device")"; \
    printf '%s UUID=%s none luks,discard,x-initrd.attach\n' "$crypt_name" "$backing_uuid" > /target/etc/crypttab; \
    in-target apt-get -y install cryptsetup-initramfs || true; \
    in-target update-initramfs -u -k all; \
{{if eq .debian_regular_swap_enabled "true" -}}
    if ! chroot /target /usr/bin/fallocate -l {{.debian_regular_swap_min_size_mib}}M /swapfile; then \
      dd if=/dev/zero of=/target/swapfile bs=1M count={{.debian_regular_swap_min_size_mib}}; \
    fi; \
    chmod 0600 /target/swapfile; \
    chroot /target /sbin/mkswap /swapfile; \
    printf '/swapfile none swap sw 0 0\n' >> /target/etc/fstab; \
{{end -}}
  fi
{{end}}

{{define "preseed/debian/storage/lvm" -}}
d-i anna/choose_modules string {{.debian_lvm_partman_modules}}

# Use selected storage method
d-i partman-auto/method string {{.storage_mode}}
d-i partman-auto-lvm/guided_size string max
d-i partman-auto-lvm/new_vg_name string {{.vg_name}}

# Make sure any leftovers can be replaced without prompts
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true

# Expert recipe: ESP + LVM PV, with root+swap LVs
# LVM recipe: ESP + PV on nvme0n1 + LVs (root, swap)
d-i partman-auto/expert_recipe string \
  uefi-lvm ::                                                            \
    {{.debian_lvm_esp_min_size_mib}} {{.debian_lvm_esp_priority}} {{.debian_lvm_esp_max_size_mib}} {{.debian_lvm_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        mountpoint{ {{.debian_lvm_esp_mountpoint}} }                     \
    .                                                                    \
    {{.debian_lvm_boot_min_size_mib}} {{.debian_lvm_boot_priority}} {{.debian_lvm_boot_max_size_mib}} {{.debian_lvm_boot_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ {{.debian_lvm_boot_fstype}} }      \
        mountpoint{ {{.debian_lvm_boot_mountpoint}} }                    \
    .                                                                    \
    {{.debian_lvm_pv_min_size_mib}} {{.debian_lvm_pv_priority}} {{.debian_lvm_pv_max_size_mib}} lvm \
        $primary{ } $iflabel{ gpt }                                      \
        method{ lvm }                                                    \
        device{ {{.storage_disk}} } \
        vg_name{ {{.vg_name}} } \
    .                                                                    \
{{if eq .debian_lvm_swap_enabled "true" -}}
    {{.debian_lvm_swap_min_size_mib}} {{.debian_lvm_swap_priority}} {{.debian_lvm_swap_max_size_mib}} linux-swap \
        $lvmok{ }                                                        \
        in_vg{ {{.vg_name}} }   \
        lv_name{ swap }                                                  \
        method{ swap } format{ }                                         \
    .                                                                    \
{{end -}}
    {{.debian_lvm_root_min_size_mib}} {{.debian_lvm_root_priority}} {{.debian_lvm_root_max_size_mib}} {{.debian_lvm_root_fstype}} \
        $lvmok{ }                                                        \
        in_vg{ {{.vg_name}} }   \
        lv_name{ root }                                                  \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ {{.debian_lvm_root_fstype}} }      \
        mountpoint{ {{.debian_lvm_root_mountpoint}} }                    \
    .

d-i partman-auto/choose_recipe select uefi-lvm
{{end}}

{{define "preseed/debian/storage/lvm/encrypted" -}}
d-i anna/choose_modules string crypto-dm-modules partman-crypto {{.debian_lvm_partman_modules}}

# Use LUKS for the PV that backs the configured volume group. ESP and /boot stay
# outside encryption so firmware and GRUB can load before the LUKS prompt.
d-i partman-auto/method string crypto
d-i partman-auto-lvm/guided_size string max
d-i partman-auto-lvm/new_vg_name string {{.vg_name}}

# Make sure any leftovers can be replaced without prompts
d-i partman-crypto/device_remove_crypto boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true

d-i partman-auto/expert_recipe string \
  uefi-lvm-luks ::                                                        \
    {{.debian_lvm_esp_min_size_mib}} {{.debian_lvm_esp_priority}} {{.debian_lvm_esp_max_size_mib}} {{.debian_lvm_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        mountpoint{ {{.debian_lvm_esp_mountpoint}} }                     \
    .                                                                    \
    {{.debian_lvm_boot_min_size_mib}} {{.debian_lvm_boot_priority}} {{.debian_lvm_boot_max_size_mib}} {{.debian_lvm_boot_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ {{.debian_lvm_boot_fstype}} }      \
        mountpoint{ {{.debian_lvm_boot_mountpoint}} }                    \
    .                                                                    \
    {{.debian_lvm_pv_min_size_mib}} {{.debian_lvm_pv_priority}} {{.debian_lvm_pv_max_size_mib}} crypto \
        $primary{ } $iflabel{ gpt }                                      \
        method{ crypto } format{ }                                       \
        options/crypto_type{ luks }                                      \
        options/cipher{ {{.storage_encryption_cipher}} }                 \
        options/keysize{ {{.storage_encryption_key_size}} }              \
        options/hash{ {{.storage_encryption_hash}} }                     \
        method{ lvm }                                                    \
        device{ {{.storage_disk}} }                                      \
        vg_name{ {{.vg_name}} }                                          \
    .                                                                    \
{{if eq .debian_lvm_swap_enabled "true" -}}
    {{.debian_lvm_swap_min_size_mib}} {{.debian_lvm_swap_priority}} {{.debian_lvm_swap_max_size_mib}} linux-swap \
        $lvmok{ }                                                        \
        in_vg{ {{.vg_name}} }                                            \
        lv_name{ swap }                                                  \
        method{ swap } format{ }                                         \
    .                                                                    \
{{end -}}
    {{.debian_lvm_root_min_size_mib}} {{.debian_lvm_root_priority}} {{.debian_lvm_root_max_size_mib}} {{.debian_lvm_root_fstype}} \
        $lvmok{ }                                                        \
        in_vg{ {{.vg_name}} }                                            \
        lv_name{ root }                                                  \
        method{ format } format{ }                                       \
        use_filesystem{ } filesystem{ {{.debian_lvm_root_fstype}} }      \
        mountpoint{ {{.debian_lvm_root_mountpoint}} }                    \
    .

d-i partman-auto/choose_recipe select uefi-lvm-luks
{{end}}

{{define "preseed/debian/storage/raid" -}}
d-i anna/choose_modules string {{.debian_raid_partman_modules}}

# Use mdadm RAID across the configured member disks.
d-i partman-auto/method string raid

# Make sure any md leftovers can be replaced without prompts.
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true
d-i mdadm/boot_degraded boolean {{.storage_raid_boot_degraded}}

# Expert recipe: ESP on each disk, then RAID members for /boot, swap, and root.
# The ESPs are normal FAT partitions because UEFI firmware does not assemble mdraid.
d-i partman-auto/expert_recipe string \
  uefi-raid1 ::                                                           \
    {{.debian_raid_esp_min_size_mib}} {{.debian_raid_esp_priority}} {{.debian_raid_esp_max_size_mib}} {{.debian_raid_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        device{ {{.storage_raid_device_0}} }                             \
        mountpoint{ {{.debian_raid_esp_mountpoint}} }                    \
    .                                                                    \
    {{.debian_raid_esp_min_size_mib}} {{.debian_raid_esp_priority}} {{.debian_raid_esp_max_size_mib}} {{.debian_raid_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        device{ {{.storage_raid_device_1}} }                             \
    .                                                                    \
    {{.debian_raid_boot_min_size_mib}} {{.debian_raid_boot_priority}} {{.debian_raid_boot_max_size_mib}} raid \
        $primary{ } $iflabel{ gpt }                                      \
        method{ raid }                                                   \
        raidid{ 1 }                                                       \
    .                                                                    \
{{if eq .debian_raid_swap_enabled "true" -}}
    {{.debian_raid_swap_min_size_mib}} {{.debian_raid_swap_priority}} {{.debian_raid_swap_max_size_mib}} raid \
        method{ raid }                                                   \
        raidid{ 2 }                                                       \
    .                                                                    \
{{end -}}
    {{.debian_raid_root_min_size_mib}} {{.debian_raid_root_priority}} {{.debian_raid_root_max_size_mib}} raid \
        method{ raid }                                                   \
        raidid{ 3 }                                                       \
    .

d-i partman-auto/choose_recipe select uefi-raid1

# Map RAID member partitions to installed filesystems.
d-i partman-auto-raid/recipe string                                      \
    1 2 0 {{.debian_raid_boot_fstype}} {{.debian_raid_boot_mountpoint}} \
        raidid=1                                                        \
    .                                                                   \
{{if eq .debian_raid_swap_enabled "true" -}}
    1 2 0 swap -                                                        \
        raidid=2                                                        \
    .                                                                   \
{{end -}}
    1 2 0 {{.debian_raid_root_fstype}} {{.debian_raid_root_mountpoint}} \
        raidid=3                                                        \
    .

# Persist mdadm assembly and duplicate EFI boot files to both ESPs.
d-i preseed/late_command string \
  in-target mkdir -p /etc/mdadm; \
  mdadm --detail --scan > /target/etc/mdadm/mdadm.conf; \
  in-target update-initramfs -u; \
  /bin/ash -c 'set -eux; \
    mkdir -p /target/boot/efi /target/boot/efi-secondary; \
    first=1; \
    for d in {{.storage_raid_devices}}; do \
      p="${d}1"; \
      case "$d" in /dev/disk/*) p="${d}-part1";; *[0-9]) p="${d}p1";; esac; \
      [ -b "$p" ] || continue; \
      if [ "$first" = 1 ]; then efi=/target/boot/efi; first=0; else efi=/target/boot/efi-secondary; mount "$p" "$efi" || continue; fi; \
      chroot /target grub-install --target=x86_64-efi --efi-directory="${efi#/target}" --bootloader-id=debian --recheck --no-nvram || true; \
      mkdir -p "$efi/EFI/BOOT"; \
      cp -f "$efi/EFI/debian/grubx64.efi" "$efi/EFI/BOOT/BOOTX64.EFI" || true; \
      [ "$efi" = /target/boot/efi ] || umount "$efi" || true; \
    done'
{{end}}

{{define "preseed/debian/storage/raid/encrypted" -}}
d-i anna/choose_modules string crypto-dm-modules partman-crypto {{.debian_raid_partman_modules}}

# Use mdadm for redundancy, then put LUKS on the md devices for swap and root.
# ESPs remain normal partitions, and /boot remains RAID1 but unencrypted.
d-i partman-auto/method string raid

# Make sure any crypto/md leftovers can be replaced without prompts.
d-i partman-crypto/device_remove_crypto boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true
d-i mdadm/boot_degraded boolean {{.storage_raid_boot_degraded}}

d-i partman-auto/expert_recipe string \
  uefi-raid1-luks ::                                                      \
    {{.debian_raid_esp_min_size_mib}} {{.debian_raid_esp_priority}} {{.debian_raid_esp_max_size_mib}} {{.debian_raid_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        device{ {{.storage_raid_device_0}} }                             \
        mountpoint{ {{.debian_raid_esp_mountpoint}} }                    \
    .                                                                    \
    {{.debian_raid_esp_min_size_mib}} {{.debian_raid_esp_priority}} {{.debian_raid_esp_max_size_mib}} {{.debian_raid_esp_fstype}} \
        $primary{ } $iflabel{ gpt }                                      \
        method{ efi } format{ }                                          \
        device{ {{.storage_raid_device_1}} }                             \
    .                                                                    \
    {{.debian_raid_boot_min_size_mib}} {{.debian_raid_boot_priority}} {{.debian_raid_boot_max_size_mib}} raid \
        $primary{ } $iflabel{ gpt }                                      \
        method{ raid }                                                   \
        raidid{ 1 }                                                       \
    .                                                                    \
{{if eq .debian_raid_swap_enabled "true" -}}
    {{.debian_raid_swap_min_size_mib}} {{.debian_raid_swap_priority}} {{.debian_raid_swap_max_size_mib}} raid \
        method{ raid }                                                   \
        raidid{ 2 }                                                       \
    .                                                                    \
{{end -}}
    {{.debian_raid_root_min_size_mib}} {{.debian_raid_root_priority}} {{.debian_raid_root_max_size_mib}} raid \
        method{ raid }                                                   \
        raidid{ 3 }                                                       \
    .

d-i partman-auto/choose_recipe select uefi-raid1-luks

d-i partman-auto-raid/recipe string                                      \
    1 2 0 {{.debian_raid_boot_fstype}} {{.debian_raid_boot_mountpoint}} \
        raidid=1                                                        \
    .                                                                   \
{{if eq .debian_raid_swap_enabled "true" -}}
    1 2 0 crypto -                                                      \
        method=crypto                                                   \
        options/crypto_type=luks                                        \
        options/cipher={{.storage_encryption_cipher}}                   \
        options/keysize={{.storage_encryption_key_size}}                \
        options/hash={{.storage_encryption_hash}}                       \
        raidid=2                                                        \
    .                                                                   \
{{end -}}
    1 2 0 crypto -                                                      \
        method=crypto                                                   \
        options/crypto_type=luks                                        \
        options/cipher={{.storage_encryption_cipher}}                   \
        options/keysize={{.storage_encryption_key_size}}                \
        options/hash={{.storage_encryption_hash}}                       \
        raidid=3                                                        \
    .

d-i preseed/late_command string \
  in-target mkdir -p /etc/mdadm; \
  mdadm --detail --scan > /target/etc/mdadm/mdadm.conf; \
  in-target update-initramfs -u; \
  /bin/ash -c 'set -eux; \
    mkdir -p /target/boot/efi /target/boot/efi-secondary; \
    first=1; \
    for d in {{.storage_raid_devices}}; do \
      p="${d}1"; \
      case "$d" in /dev/disk/*) p="${d}-part1";; *[0-9]) p="${d}p1";; esac; \
      [ -b "$p" ] || continue; \
      if [ "$first" = 1 ]; then efi=/target/boot/efi; first=0; else efi=/target/boot/efi-secondary; mount "$p" "$efi" || continue; fi; \
      chroot /target grub-install --target=x86_64-efi --efi-directory="${efi#/target}" --bootloader-id=debian --recheck --no-nvram || true; \
      mkdir -p "$efi/EFI/BOOT"; \
      cp -f "$efi/EFI/debian/grubx64.efi" "$efi/EFI/BOOT/BOOTX64.EFI" || true; \
      [ "$efi" = /target/boot/efi ] || umount "$efi" || true; \
    done'
{{end}}

{{define "preseed/debian/storage/commit" -}}
# Commit without asking
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman/choose_partition select finish
{{end}}

{{define "preseed/debian/storage/grub" -}}
# ---- GRUB (UEFI)
d-i grub-installer/target string amd64-efi
d-i grub2/linux_cmdline string {{.boot_installed_args}}
{{end}}

{{define "preseed/debian/packages" -}}
# ---- Packages
d-i user-setup/encrypt-home boolean {{ .encrypt_home }}
d-i base-installer/install-recommends boolean true
d-i clock-setup/ntp boolean {{.time_ntp}}
d-i debian-installer/quiet boolean false
d-i debian-installer/splash boolean false
d-i pkgsel/update-policy select {{.packages_update_policy}}
d-i pkgsel/include string {{.packages_install}}
d-i pkgsel/include string sudo
{{end}}

{{define "preseed/debian/finish" -}}
d-i grub-installer/timeout string {{.boot_timeout_seconds}}
d-i popularity-contest/participate boolean false
d-i finish-install/reboot_in_progress note
{{end}}
